@using mqtt2otel.Metadata

<div data-testid="metric-result-container">
    @if (this.Metrics != null)
    {
        @foreach (var metric in this.Metrics)
        {
            <Card class="overflow-x-auto" style="margin:10px;" data-testid="metric-result-entry">
                <CardHeader class="d-flex align-items-center">
                    <div data-testid="metric-name"><b>@metric.Name</b></div>
                    <div class="ms-auto d-flex flex-wrap justify-content-end">
                        <b data-testid="metric-type">@metric.MetricType</b>
                    </div>
                </CardHeader>
                <CardBody>

                    @if (this.ShowDetails)
                    {
                        <ConnectionDetailsViewer Connection="@metric.Connection" Metric="@metric" />
                    }

                    <table class="table">
                        <tbody>
                            <tr>
                                <td style="width: 1%"><b>Description: </b></td>
                                <td data-testid="metric-description">@metric.Description</td>
                            </tr>
                        </tbody>
                    </table>

                    <table class="table" data-testid="metric-points">
                        <thead>
                            <tr>
                                <th>Value</th>
                                <th>StartTime</th>
                                <th>EndTime</th>
                                <th>Attribute</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var metricPoint in metric.MetricPoints)
                            {
                                <tr data-testid="metric-point">
                                    <td><span data-testid="metric-point-value">@metricPoint.Value</span> <span data-testid="metric-point-unit">@metric.Unit</span></td>
                                    <td data-testid="metric-point-start">@metricPoint.StartTime.ToString("yyyy-MM-ddTHH:mm:ssZ")</td>
                                    <td data-testid="metric-point-end">@metricPoint.EndTime.ToString("yyyy-MM-ddTHH:mm:ssZ")</td>
                                    <td>
                                        @foreach (var tag in metricPoint.Tags)
                                        {
                                            <OtelAttribute Value="@tag" />
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </CardBody>

            </Card>
        }
    }
</div>

@code
{
    /// <summary>
    /// Gets or sets the metrics that should be shown by this viewer.
    /// </summary>
    [Parameter]
    public List<MetricTestData>? Metrics { get; set; }

    /// <summary>
    /// Gets a value indicating, whether all details should be shown.
    /// </summary>
    [Parameter]
    public bool ShowDetails
    {
        get => field;

        set
        {
            if (field != value)
            {
                field = value;
                this.ShowDetailsChanged.InvokeAsync(value);
            }
        }
    }

    /// <summary>
    /// Used for two way binding. Called, when ShowDetails has changed.
    /// </summary>
    [Parameter]
    public EventCallback<bool> ShowDetailsChanged { get; set; }
}
