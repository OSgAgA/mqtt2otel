@using mqtt2otel.ManifestExplorer.Helper
@inject IJSRuntime JS
@inject NavigationManager NavManager
@inject ILogger<ManifestEditor> logger

<Card id="manifest-editor-container">
    <CardHeader class="d-flex justify-content-between align-items-center" style="background-color: #dbeaf1">
        <b>mqtt2otel manifest</b>

        <div>
            <button class="btn btn-outline-primary me-2" @onclick="AddServerStubs">
                Add server stubs
            </button>
            <button class="btn btn-outline-primary" @onclick="CopyManifest">
                Copy
            </button>
        </div>
    </CardHeader>
    <StandaloneCodeEditor @ref="manifestEditor" Id="@editorId" CssClass="manifest-editor" ConstructionOptions="EditorOptions" OnDidInit="OnEditorInit" />
</Card>

@code
{

    [Parameter, EditorRequired]
    public string InitialText { get; set; }

    /// <summary>
    /// Gives the editor a unique id on each page load and avoids race conditions, when a page is reloaded and the dispose from the
    /// old editor collides with the creation of a new editor with the same name.
    /// </summary>
    private readonly string editorId = $"manifest-editor-{Guid.NewGuid():N}";

    /// <summary>
    /// Contains a reference to the manifest editor
    /// </summary>
    private StandaloneCodeEditor? manifestEditor;

    /// <summary>
    /// A guard for testing, whether the manifest editor is initialized.
    /// </summary>
    private bool editorIsInitialized = false;

    /// <summary>
    /// A flag indicating whether disposed has been called.
    /// </summary>
    private bool disposed;

    /// <summary>
    /// Gets the value of the manifest editor as a simple text string.
    /// </summary>
    /// <returns>The current value of the editor.</returns>
    public async Task<string> GetValueAsString()
    {
        if (this.manifestEditor != null) return await this.manifestEditor.GetValue();

        return string.Empty;
    }

    /// <summary>
    /// Disposes the editor.
    /// </summary>
    public ValueTask DisposeAsync()
    {
        disposed = true;
        return ValueTask.CompletedTask;
    }

    /// <summary>
    /// Called when the editor init event is called. 
    /// </summary>
    private async Task OnEditorInit()
    {
        if (disposed || manifestEditor == null) return;
        try
        {
            await JS.InvokeVoidAsync("waitForMonaco", null);
            if (disposed) return;

            await manifestEditor.SetValue(this.InitialText);
            await manifestEditor.Layout();
            await JS.InvokeVoidAsync("manifestCompletion.register",
                new ManifestCompletionService().Generate());

            editorIsInitialized = true;
            StateHasChanged();
        }
        catch (JSException) when (disposed)
        {
            // torn down while initializing, nothing to do
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error on monaco editor init!");
        }
    }

    /// <summary>
    /// Sets the value of the editor as a text value.
    /// </summary>
    /// <param name="text">The text to be set.</param>
    public async Task SetValueAsText(string text)
    {
        if (!editorIsInitialized || disposed || manifestEditor == null) return;
        try
        {
            await manifestEditor.SetValue(text);
            await manifestEditor.Layout();
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Could not set value on monaco editor.");
        }
    }
    /// <summary>
    /// Adds server stubs to the manifest, so that a complete manifest is available that can be used for further processing.
    /// </summary>
    private async Task AddServerStubs()
    {
        string serverStub = """
Version: 1.1

MqttConnections:
  - Name: "My broker"
    Endpoint:
      Port: 1813
      Protocol: tcp
      Address: "mymqtt-broker.net"

OtelConnections:
  - Name: "My Otel server"
    ServiceName: "my-service"
    ServiceNamespace: "my-service-namespace"
    Endpoint:
      Address: "https://my-otel-collector.net"

""";

        var text = await this.GetValueAsString();
        text = serverStub + (text.StartsWith('\n') ? "" : "\n") + text;

        await this.SetValueAsText(text);
    }

    /// <summary>
    /// Copies the manifest string into the paste buffer.
    /// </summary>
    /// <returns></returns>
    private async Task CopyManifest()
    {
        await JS.InvokeVoidAsync("copyToClipboard", await this.GetValueAsString());
    }

    /// <summary>
    /// Sets the options of the monacco editor at construction time.
    /// </summary>
    /// <param name="editor">The editor for which the options should be set.</param>
    /// <returns>The created options.</returns>
    private StandaloneEditorConstructionOptions EditorOptions(StandaloneCodeEditor editor)
    {
        return new StandaloneEditorConstructionOptions
        {
            AutomaticLayout = true,
            Language = "yaml",
            Value = " ",
            Minimap = new EditorMinimapOptions { Enabled = false },
            OverviewRulerLanes = 0,          // removes the ruler lanes
            HideCursorInOverviewRuler = true, // hides the cursor marker
            FontSize = 16,
            Scrollbar = new EditorScrollbarOptions
            {
                Vertical = "auto",
                Horizontal = "auto",
                AlwaysConsumeMouseWheel = false,
                UseShadows = true
            }
        };
    }
}
