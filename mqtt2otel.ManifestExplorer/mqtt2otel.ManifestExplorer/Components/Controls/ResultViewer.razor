@using mqtt2otel.ManifestExplorer.DTOs
<Card>
    <CardHeader class="d-flex justify-content-between align-items-center" style="background-color: #dbeaf1">
        <b>Result</b>
        <div class="view-switcher" style="padding: 7px;">
            <span class="view-label @(ShowDetails ? "" : "active")">
                Simple
            </span>

            <Switch @bind-Value="ShowDetails" />

            <span class="view-label @(ShowDetails ? "active" : "")">
                Extended
            </span>
        </div>
    </CardHeader>
    <Tabs data-testid="result-container" @ref="tabs" EnableFadeEffect="true" NavStyle="NavStyle.Tabs">
        <Tab data-testid="errors-result-header" @bind-Title="@this.errorTitle">
            <Content>
                <div>
                    <Card style="margin:10px">
                        <TextAreaInput class="form-control w-100" title="Errors" @bind-Value="@this.errorText" style="color: #660000; font-weight:500" readonly />
                    </Card>
                </div>
            </Content>
        </Tab>
        <Tab data-testid="metrics-result-header" @bind-Title="this.metricsTitle" IsActive="true">
            <Content>
                <MetricResultViewer Metrics="@this.Data?.Metrics" @bind-ShowDetails="@ShowDetails" />
            </Content>
        </Tab>
        <Tab data-testid="logs-result-header" @bind-Title="@this.logsTitle">
            <Content>
                <LogResultViewer LogEntries="@this.Data?.Logs" @bind-ShowDetails="@ShowDetails" />
            </Content>
        </Tab>

    </Tabs>
</Card>

@code
{
    /// <summary>
    /// Gets or sets the data that should be presented in the viewer.
    /// </summary>
    [Parameter]
    public ApplyPatternToPayloadResult? Data { get; set; }

    /// <summary>
    /// Gets a value indicating, whether all details should be shown.
    /// </summary>
    [Parameter]
    public bool ShowDetails
    {
        get => field;

        set
        {
            if (field != value)
            {
                field = value;
                this.ShowDetailsChanged.InvokeAsync(value);
            }
        }
    }

    /// <summary>
    /// Used for two way binding. Called, when ShowDetails has changed.
    /// </summary>
    [Parameter]
    public EventCallback<bool> ShowDetailsChanged { get; set; }

    /// <summary>
    /// The tabs controll that contains the different results.
    /// </summary>
    Tabs tabs = new();

    ///# <summary>
    /// The tilte of the error tab.
    /// </summary>
    private string errorTitle = "Errors";

    /// <summary>
    /// The title of the metric tab.
    /// </summary>
    private string metricsTitle = "Metrics";

    /// <summary>
    /// The title of the log tab.
    /// </summary>
    private string logsTitle = "Logs";

    /// <summary>
    /// The text representation of the error result.
    /// </summary>
    private string errorText = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (this.Data != null)
        {
            this.errorText = this.Data.GetErrorsAsString();

            this.errorTitle = $"Errors ({this.Data.Errors.Count})";
            this.metricsTitle = $"Metrics ({this.Data.Metrics.Count})";
            this.logsTitle = $"Logs ({this.Data.Logs.Count})";

            if (this.Data.HasErrors)
            {
                await this.tabs.ShowTabByIndexAsync(0);
            }
            else if (this.Data.HasMetrics)
            {
                await this.tabs.ShowTabByIndexAsync(1);
            }
            else if (this.Data.HasLogs)
            {
                await this.tabs.ShowTabByIndexAsync(2);
            }

            this.StateHasChanged();
        }
    }
}
