@using mqtt2otel.Metadata
<div style="padding: 15px;">
    @if (this.LogEntries != null)
    {
        <Card class="overflow-x-auto">

            <table data-testid="log-result-container" class="table overflow-x-auto">
                <thead>
                    <tr>
                        <th>Timestamp</th>
                        <th>Level</th>
                        <th>Body</th>
                        <th>Attribute</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var logEntry in this.LogEntries)
                    {
                        <tr>
                            <td colspan="4">
                            @if (this.ShowDetails)
                            {
                                <ConnectionDetailsViewer Connection="@logEntry.Connection" />
                            }
                            </td>
                        </tr>

                        <tr data-testid="log-result-entry">
                            <td data-testid="log-result-timestamp">@logEntry.Timestamp.ToString("yyyy-MM-ddTHH:mm:ssZ")</td>
                            <td data-testid="log-result-level">@logEntry.LogLevel</td>
                            <td data-testid="log-result-body">@logEntry.Body</td>
                            <td>
                                @foreach (var tag in logEntry.Attributes.Where(tag => !tag.Key.StartsWith("otel_")))
                                {
                                    <OtelAttribute Value="@tag" />
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </Card>
    }
</div>


@code {

    /// <summary>
    /// Gets or sets the log entries that should be shown by the viewer.
    /// </summary>
    [Parameter]
    public List<LogTestData>? LogEntries { get; set; }

    /// <summary>
    /// Gets a value indicating, whether all details should be shown.
    /// </summary>
    [Parameter]
    public bool ShowDetails
    {
        get => field;

        set
        {
            if (field != value)
            {
                field = value;
                this.ShowDetailsChanged.InvokeAsync(value);
            }
        }
    }

    /// <summary>
    /// Used for two way binding. Called, when ShowDetails has changed.
    /// </summary>
    [Parameter]
    public EventCallback<bool> ShowDetailsChanged { get; set; }
}
