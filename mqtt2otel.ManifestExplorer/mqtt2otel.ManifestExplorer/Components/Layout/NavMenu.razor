@using mqtt2otel.ManifestExplorer.Settings
@inject ApplicationInfo appInfo

<div class="top-row ps-3 navbar-light" style="align-content:center;">
    <div class="container-fluid-flex" style="text-align: center;">
        <img src="images/logo-new.png" alt="mqtt2otel logo" class="img-fluid" />
        <p>Explorer Version: @appInfo.Version</p>
    </div>
</div>

<input type="checkbox" class="navbar-toggler" id="menuToggle">

<label class="navbar-toggler" for="menuToggle">
    <span></span>
</label>

<div></div>

<div class="nav-scrollable" onclick="menuToggle.click()">

    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/Explorer">
                Explorer
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="examples">
                Examples
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="https://mqtt2otel.org/docs/introduction/">
                mqtt2otel Documentation
            </NavLink>
        </div>
    </nav>
</div>

