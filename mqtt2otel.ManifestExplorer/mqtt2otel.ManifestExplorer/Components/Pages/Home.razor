@page "/{ExampleId?}"
@using mqtt2otel.ManifestExplorer.Components.Controls
@using mqtt2otel.ManifestExplorer.DTOs
@using mqtt2otel.ManifestExplorer.Settings
@using mqtt2otel.Shared
@inject IJSRuntime JS

@rendermode InteractiveServer
@inject IHttpClientFactory Factory
@inject Microsoft.Extensions.Options.IOptions<FeatureToggles> featureToggles
@inject mqtt2otel.ManifestExplorer.Meters.UsageMeter usageMeter

<PageTitle>mqtt2otel manifest explorer</PageTitle>

<div class="flex-container">

    <CreateJsonDialog @ref="modal" Data="@this.Data" Result="@this.Result" />

    <div class="row">

        @* The mqtt part *@

        <div class="col">
            <h2>MQTT</h2>
            <div class="flex-container">
                <div class="row">
                    <div class="col" style="margin-bottom:20px;">
                        <Card>
                            <CardHeader>
                                <b>Topic</b>
                            </CardHeader>
                            <InputText @bind-Value="@this.Data.Setup.Topic" />
                        </Card>
                    </div>
                </div>
                <div class="row">
                    <div class="col" style="margin-bottom:20px;">
                        <Card>
                            <CardHeader>
                                <b>Payload</b>
                            </CardHeader>
                            <InputTextArea class="form-control w-100" title="Payload" @bind-Value="@this.Data.Setup.Payload" rows="22" />
                        </Card>
                    </div>
                </div>

                <div class="row">
                    <div class="col">
                        <Card>
                            <CardHeader class="d-flex justify-content-between align-items-center">
                                <b>User properties</b>

                                <div>
                                    <button class="btn btn-outline-primary me-2" @onclick="AddUserProperty">
                                        Add
                                    </button>
                                </div>
                            </CardHeader>
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th scope="col">Name</th>
                                        <th scope="col">Value</th>
                                        <th scope="col">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var property in this.Data.Setup.UserProperties)
                                    {
                                        <tr>
                                            <td><InputText class="form-control w-100" @bind-Value="@property.Name" /></td>
                                            <td><InputText class="form-control w-100" @bind-Value="@property.Value" /></td>
                                            <td><button class="btn btn-outline-primary me-2" @onclick="() => DeleteUserProperty(property)">Delete</button></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </Card>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-auto d-flex align-items-center">
            <img src="images/play_no_circle.png" style="width:80px" />
        </div>

        @* The mqtt2otel part *@

        <div class="col">
            <h2>to Open Telemetry</h2>
            <Card>
                <CardHeader class="d-flex justify-content-between align-items-center">
                    <b>Manifest</b>

                    <div>
                        <button class="btn btn-outline-primary me-2" @onclick="AddServerStubs">
                            Add server stubs
                        </button>
                        <button class="btn btn-outline-primary" @onclick="CopyManifest">
                            Copy
                        </button>
                    </div>
                </CardHeader>
                <InputTextArea id="editor" class="form-control w-100" title="Manifest" @bind-value="@this.Data.Setup.Manifest" rows="24" />
            </Card>

            @* The buttons *@

            <div class="row">
                <div class="col" style="text-align: center">
                    <button class="btn btn-primary" style="margin:20px; width:150px" @onclick="Apply">Apply</button>
                    @if (featureToggles.Value.ShowCreateJsonButton)
                    {
                        <button class="btn btn-primary" style="margin:20px; width:150px" @onclick="ShowModal">Create Json</button>
                    }
                </div>
            </div>

            <hr />

            @* The results *@

            <div class="row">
                <div class="col">
                    <Card>
                        <CardHeader>
                            <b>Result</b>
                        </CardHeader>
                        <Tabs @ref="tabs" EnableFadeEffect="true" NavStyle="NavStyle.Tabs">
                            <Tab @bind-Title="@this.errorTitle" Id="ErrorsTab">
                                <Content>
                                    <InputTextArea class="form-control w-100" title="Errors" @bind-Value="@this.errorText" rows="15" />
                                </Content>
                            </Tab>
                            <Tab @bind-Title="@this.metricsTitle" IsActive="true">
                                <Content>
                                    <InputTextArea class="form-control w-100" title="Result" @bind-Value="@this.resultMetricsText" rows="15" />
                                </Content>
                            </Tab>
                            <Tab @bind-Title="@this.logsTitle">
                                <Content>
                                    <InputTextArea class="form-control w-100" title="Result" @bind-Value="@this.resultLogText" rows="10" />
                                </Content>
                            </Tab>
                        </Tabs>
                    </Card>
                </div>
            </div>
        </div>

    </div>
</div>

@code {
    /// <summary>
    /// The tabs controll that contains the different results.
    /// </summary>
    Tabs tabs = new();

    /// <summary>
    /// The modal dialog used for creating json data.
    /// </summary>
    CreateJsonDialog modal = new();

    /// <summary>
    /// The id of the example that should be used to prefill the page. May be null if no example is provided.
    /// </summary>
    [Parameter]
    public string? ExampleId { get; set; }

    ///# <summary>
    /// The tilte of the error tab.
    /// </summary>
    private string errorTitle = "Errors";

    /// <summary>
    /// The title of the metric tab.
    /// </summary>
    private string metricsTitle = "Metrics";

    /// <summary>
    /// The title of the log tab.
    /// </summary>
    private string logsTitle = "Logs";

    /// <summary>
    /// The text representation of the metric result.
    /// </summary>
    private string resultMetricsText = string.Empty;

    /// <summary>
    /// The text representation of the error result.
    /// </summary>
    private string errorText = string.Empty;

    /// <summary>
    /// The text representation of the log result.
    /// </summary>
    private string resultLogText = string.Empty;

    /// <summary>
    /// The result received via the ApplyPatternToPayload request. Maybe null if request is not yet called,
    /// or if not successfull.
    /// </summary>
    private ApplyPatternToPayloadResult? Result = null;

    /// <summary>
    /// A guard to test, whether the page is already initialized.
    /// </summary>
    private bool isInitialized = false;

    /// <summary>
    /// Contains the data used by the explorer for testing different inputs based on incoming messages.
    /// </summary>
    private TestCaseData Data = new TestCaseData();

    /// <summary>
    /// Apply the provided data and set the result tabs.
    /// </summary>
    private async Task Apply()
    {
        this.usageMeter.ExampleAppliedCounter.Add(1);

        var httpClient = Factory.CreateClient("ServerAPI");

        var request = new ApplyPatternToPayloadData(this.Data.Setup.Topic, this.Data.Setup.Payload, this.Data.Setup.Manifest, this.Data.Setup.UserProperties);
        var response = await httpClient.PostAsJsonAsync("api/ManifestExplorer/ApplyPatternToPayload", request);

        var result = await response.Content.ReadFromJsonAsync<ApplyPatternToPayloadResult>();

        if (result != null)
        {
            this.resultMetricsText = result.GetMetricsAsString();
            this.resultLogText = result.GetLogsAsString();
            this.errorText = result.GetErrorsAsString();

            this.errorTitle = $"Errors ({result.Errors.Count})";
            this.metricsTitle = $"Metrics ({result.Metrics.Count})";
            this.logsTitle = $"Logs ({result.Logs.Count})";

            if (result.HasErrors)
            {
                await this.tabs.ShowTabByIndexAsync(0);
            }
            else if (result.HasMetrics)
            {
                await this.tabs.ShowTabByIndexAsync(1);
            }
            else if (result.HasLogs)
            {
                await this.tabs.ShowTabByIndexAsync(2);
            }
        }

        this.Result = result;
    }

    /// <summary>
    /// Called when the side is initialized. Will load example data if an example id is provided.
    /// </summary>
    /// <returns></returns>
    protected override Task OnInitializedAsync()
    {
        if (!this.isInitialized)
        {
            this.isInitialized = true;

            var pageTags = new System.Diagnostics.TagList()
            {
                { "Page", "Home"}
            };

            this.usageMeter.PageRequestedCounter.Add(1, pageTags);

            if (this.ExampleId != null)
            {
                var exampleTags = new System.Diagnostics.TagList()
            {
                { "ExampleId", this.ExampleId}
            };

                this.usageMeter.ExampleRequestedCounter.Add(1, exampleTags);
            }
        }

        if (this.ExampleId != null)
        {

            this.Data = TestCaseData.GetById(this.ExampleId);
        }

        return base.OnInitializedAsync();
    }

    /// <summary>
    /// Shows the modal dialog.
    /// </summary>
    private async Task ShowModal()
    {
        await modal.Show();
    }

    /// <summary>
    /// Adds server stubs to the manifest, so that a complete manifest is available that can be used for further processing.
    /// </summary>
    private void AddServerStubs()
    {
        string serverStub = """
Version: 1.0

MqttConnections:
  - Name: "My broker"
    Endpoint:
      Port: 1813
      Protocol: tcp
      Address: "mymqtt-broker.net"
      EnableTls: false

OtelConnections:
  - Name: "My Otel server"
    ServiceName: "my-service"
    ServiceNamespace: "my-service-namespace"
    Endpoint:
      Protocol: "http"
      Port: 4317
      Address: "my-otel-collector.net"
      EnableTls: false

""";

        this.Data.Setup.Manifest = serverStub + (this.Data.Setup.Manifest.StartsWith('\n') ? "" : "\n") + this.Data.Setup.Manifest;
    }

    /// <summary>
    /// Adds a new mqtt user property.
    /// </summary>
    private void AddUserProperty()
    {
        this.Data.Setup.UserProperties.Add(new UserProperty());

        this.StateHasChanged();
    }

    /// <summary>
    /// Deletes an existing user property.
    /// </summary>
    /// <param name="property">The property to be deleted.</param>
    private void DeleteUserProperty(UserProperty property)
    {
        this.Data.Setup.UserProperties.Remove(property);

        this.StateHasChanged();
    }

    /// <summary>
    /// Copies the manifest string into the paste buffer.
    /// </summary>
    /// <returns></returns>
    private async Task CopyManifest()
    {
        await JS.InvokeVoidAsync("copyToClipboard", this.Data.Setup.Manifest);
    }

}
