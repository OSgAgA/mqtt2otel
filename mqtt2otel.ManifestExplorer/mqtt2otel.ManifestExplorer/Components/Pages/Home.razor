@page "/{ExampleId?}"
@using mqtt2otel.ManifestExplorer.DTOs
@using mqtt2otel.Metadata
@using System.Text.Json
@using mqtt2otel.ManifestExplorer.Settings
@inject IJSRuntime JS

@rendermode InteractiveServer
@inject IHttpClientFactory Factory
@inject Microsoft.Extensions.Options.IOptions<FeatureToggles> featureToggles

<PageTitle>mqtt2otel manifest explorer</PageTitle>

<div class="flex-container">

    <Modal @ref="modal" Title="Enter Json Data" IsVerticallyCentered="true" Size="ModalSize.Large">
        <BodyTemplate>
            <div class="row" style="margin-bottom:10px">
                <div class="col-3">
                    <label>Id</label>
                </div>
                <div class="col-8">
                    <InputText class="form-control w-100" @bind-Value="@this.testCaseId" />
                </div>
            </div>

            <div class="row" style="margin-bottom:10px">
                <div class="col-3">
                    <label>Name</label>
                </div>
                <div class="col-8">
                    <InputText class="form-control w-100" @bind-Value="@this.testCaseName" />
                </div>
            </div>

            <div class="row" style="margin-bottom:10px">
                <div class="col-3">
                    <label>Description</label>
                </div>
                <div class="col-8">
                    <InputTextArea class="form-control w-100" @bind-Value="@this.testCaseDescription" rows="5" />
                </div>
            </div>

            <div class="row" style="margin-bottom:10px">
                <div class="col-3">
                    <label>Category</label>
                </div>
                <div class="col-8">
                    <InputText class="form-control w-100" @bind-Value="@this.category" />
                </div>
            </div>

            <div class="row" style="margin-bottom:10px">
                <div class="col-3">
                    <label>Tags</label>
                </div>
                <div class="col-8">
                    <InputText class="form-control w-75" @bind-Value:get="@this.tagInput" @bind-Value:set="@this.OnTagInputChanged" />
                    @foreach (var tag in this.tags)
                    {
                        <Button Color="ButtonColor.Success" Style="margin:10px">@tag</Button>
                    }
                </div>
            </div>

            <div class="row" style="margin-bottom:10px">
                <div class="col-3">
                    <label>Create example</label>
                </div>
                <div class="col-1">
                    <CheckboxInput class="form-control w-50" @bind-Value="@this.createExample" />
                </div>
            </div>

            <div class="row" style="margin-bottom:10px">
                <div class="col-3">
                    <label>Only validate manifest</label>
                </div>
                <div class="col-1">
                    <CheckboxInput class="form-control w-50" @bind-Value="@this.validateManifestOnly" />
                </div>
            </div>
        </BodyTemplate>
        <FooterTemplate>
            <Button Color="ButtonColor.Secondary" @onclick="HideModal">Close</Button>
            <Button Color="ButtonColor.Primary" @onclick="CreateJson">Copy Json to clipboard</Button>
        </FooterTemplate>
    </Modal>

    <div class="row">
        <div class="col">
            <Card>
                <CardHeader>
                    <b>Manifest</b>
                </CardHeader>
                <InputTextArea id="editor" class="form-control w-100" title="Manifest" @bind-value="@this.manifest" rows="26"/>
            </Card>
        </div>
        <div class="col">
            <div class="flex-container">
                <div class="row">
                    <div class="col" style="margin-bottom:20px;">
                        <Card>
                            <CardHeader>
                                <b>Topic</b>
                            </CardHeader>
                            <InputText @bind-Value="@this.topic"/>
                        </Card>
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <Card>
                            <CardHeader>
                                <b>Payload</b>
                            </CardHeader>
                            <InputTextArea class="form-control w-100" title="Payload" @bind-Value="@this.payload" rows="22"/>
                        </Card>
                    </div>
                </div>
            </div>
        </div>
        <div class="row" style="text-align:center">
            <div class="col">
                <button class="btn btn-primary" style="margin:20px; width:150px" @onclick="Apply">Apply</button>
                @if (featureToggles.Value.ShowCreateJsonButton)
                {
                    <button class="btn btn-primary" style="margin:20px; width:150px" @onclick="ShowModal">Create Json</button>
                }
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <hr />
            </div>
        </div>

        <div class="row">
            <div class="col">
                <Tabs @ref="tabs" EnableFadeEffect="true" NavStyle="NavStyle.Tabs">
                    <Tab @bind-Title="@this.errorTitle" Id="ErrorsTab">
                        <Content>
                            <InputTextArea class="form-control w-100" title="Errors" @bind-Value="@this.errorText" rows="15" />
                        </Content>
                    </Tab>
                    <Tab @bind-Title="@this.metricsTitle" IsActive="true">
                        <Content>
                            <InputTextArea class="form-control w-100" title="Result" @bind-Value="@this.resultMetricsText" rows="15" />
                        </Content>
                    </Tab>
                    <Tab @bind-Title="@this.logsTitle">
                        <Content>
                            <InputTextArea class="form-control w-100" title="Result" @bind-Value="@this.resultLogText" rows="10" />
                        </Content>
                    </Tab>
                </Tabs>
            </div>
        </div>
    </div>
</div>

@code {
    /// <summary>
    /// The tabs controll that contains the different results.
    /// </summary>
    Tabs tabs = new();

    /// <summary>
    /// The modal dialog used for creating json data.
    /// </summary>
    Modal modal = new();

    /// <summary>
    /// The id of the example that should be used to prefill the page. May be null if no example is provided.
    /// </summary>
    [Parameter]
    public string? ExampleId { get; set; }

    ///# <summary>
    /// The tilte of the error tab.
    /// </summary>
    private string errorTitle = "Errors";

    /// <summary>
    /// The title of the metric tab.
    /// </summary>
    private string metricsTitle = "Metrics";

    /// <summary>
    /// The title of the log tab.
    /// </summary>
    private string logsTitle = "Logs";

    /// <summary>
    /// The test case id used by the modal dialog.
    /// </summary>
    private string testCaseId = string.Empty;

    /// <summary>
    /// The test case name used by the modal dialog.
    /// </summary>
    private string testCaseName = string.Empty;

    /// <summary>
    /// The test case description used by the modal dialog.
    /// </summary>
    private string testCaseDescription = string.Empty;

    /// <summary>
    /// Indicating whether an example should be created from this data, or only tests.
    /// </summary>
    private bool createExample = true;

    /// <summary>
    /// Indicating whether only the manifest should be validated at testing. All other information, e.g. payload, or results
    /// are ignored.
    /// </summary>
    private bool validateManifestOnly = false;

    /// <summary>
    /// The current value of the tags input field.
    /// </summary>
    private string tagInput = string.Empty;

    /// <summary>
    /// The category of the example case.
    /// </summary>
    private string category = string.Empty;

    /// <summary>
    /// The parsed tags from the tag input field.
    /// </summary>
    private List<string> tags = new();

    /// <summary>
    /// The simulated mqtt payload.
    /// </summary>
    private string payload = string.Empty;

    /// <summary>
    /// The mqtt2otel manifest data.
    /// </summary>
    private string manifest = string.Empty;

    /// <summary>
    /// The text representation of the metric result.
    /// </summary>
    private string resultMetricsText = string.Empty;

    /// <summary>
    /// The text representation of the error result.
    /// </summary>
    private string errorText = string.Empty;

    /// <summary>
    /// The text representation of the log result.
    /// </summary>
    private string resultLogText = string.Empty;

    /// <summary>
    /// The mqtt topic.
    /// </summary>
    private string topic = "message-topic";

    /// <summary>
    /// The result received via the ApplyPatternToPayload request. Maybe null if request is not yet called,
    /// or if not successfull.
    /// </summary>
    private ApplyPatternToPayloadResult? Result = null;


    /// <summary>
    /// Called when the page is initializes. Sets the test case data if a test case is provided via a page parameter.
    /// </summary>
    protected override void OnInitialized()
    {
        base.OnInitialized();

        if (!string.IsNullOrWhiteSpace(this.ExampleId))
        {
            var example = TestCaseData.GetById(this.ExampleId);

            this.testCaseId = example.Setup.Id;
            this.testCaseName = example.Setup.Name;
            this.testCaseDescription = example.Setup.Description;
            this.category = example.Setup.Category;
            this.tags = example.Setup.Tags;
            this.createExample = example.Setup.CreateExample;
        }
    }
    /// <summary>
    /// Apply the provided data and set the result tabs.
    /// </summary>
    private async Task Apply()
    {
        var httpClient = Factory.CreateClient("ServerAPI");

        var request = new ApplyPatternToPayloadData(this.topic, this.payload, this.manifest);
        var response = await httpClient.PostAsJsonAsync("api/ManifestExplorer/ApplyPatternToPayload", request);

        var result = await response.Content.ReadFromJsonAsync<ApplyPatternToPayloadResult>();

        if (result != null)
        {
            this.resultMetricsText = result.GetMetricsAsString();
            this.resultLogText = result.GetLogsAsString();
            this.errorText = result.GetErrorsAsString();

            this.errorTitle = $"Errors ({result.Errors.Count})";
            this.metricsTitle = $"Metrics ({result.Metrics.Count})";
            this.logsTitle = $"Logs ({result.Logs.Count})";

            if (result.HasErrors)
            {
                await this.tabs.ShowTabByIndexAsync(0);
            }
            else if (result.HasMetrics)
            {
                await this.tabs.ShowTabByIndexAsync(1);
            }
            else if (result.HasLogs)
            {
                await this.tabs.ShowTabByIndexAsync(2);
            }
        }

        this.Result = result;
    }

    /// <summary>
    /// Copy Json into the clipboard.
    /// </summary>
    private async Task CreateJson()
    {
        if (this.Result != null)
        {
            var testcase = new TestCaseData()
            {
                Setup = new ExampleData(this.testCaseId, this.testCaseName, this.testCaseDescription, this.topic, this.payload, this.manifest, this.category, this.tags, this.createExample, this.validateManifestOnly),
                ExpectedResult = new ExpectedTestResult(this.Result.Metrics, this.Result.Logs)
            };

            var options = new JsonSerializerOptions
            {
                WriteIndented = true,
            };

            var jsonString = JsonSerializer.Serialize(testcase, options);

            await JS.InvokeVoidAsync("copyToClipboard", jsonString);

            await modal.HideAsync();
        }
    }

    /// <summary>
    /// Called when the side is initialized. Will load example data if an example id is provided.
    /// </summary>
    /// <returns></returns>
    protected override Task OnInitializedAsync()
    {
        if (this.ExampleId != null)
        {
            var example = ExampleData.GetExampleById(this.ExampleId);

            this.topic = example.Topic;
            this.payload = example.Payload;
            this.manifest = example.Manifest;
        }

        return base.OnInitializedAsync();
    }

    /// <summary>
    /// Shows the modal dialog.
    /// </summary>
    private async Task ShowModal()
    {
        await modal.ShowAsync();
    }

    /// <summary>
    /// Hides the modal dialog.
    /// </summary>
    /// <returns></returns>
    private async Task HideModal()
    {
        await modal.HideAsync();
    }

    /// <summary>
    /// Called when the value of the tag input field has changed.
    /// </summary>
    /// <param name="currentValue">The current value of the tag input field.</param>
    private void OnTagInputChanged(string currentValue)
    {
        this.tags = new();

        var split = currentValue.Split(' ');

        foreach (var tag in split)
        {
            this.tags.Add(tag);
        }

        this.tagInput = currentValue;
        this.StateHasChanged();
    }
}
