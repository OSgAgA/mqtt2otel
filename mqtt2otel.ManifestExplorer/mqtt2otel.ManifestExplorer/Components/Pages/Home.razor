@page "/{ExampleId?}"
@using mqtt2otel.ManifestExplorer.DTOs

@rendermode InteractiveServer
@inject IHttpClientFactory Factory

<PageTitle>mqtt2otel manifest explorer</PageTitle>

<div class="flex-container">
    <div class="row">
        <div class="col">
            <Card>
                <CardHeader>
                    <b>Manifest</b>
                </CardHeader>
                <InputTextArea id="editor" class="form-control w-100" title="Manifest" @bind-value="@this.processorPattern" rows="26" />
            </Card>
        </div>
        @* <div class="vr"></div> *@
        <div class="col">
            <Card>

                <div class="flex-container">
                    <div class="row">
                        <div class="col" style="margin-bottom:20px;">
                            <Card>
                                <CardHeader>
                                    <b>Topic</b>
                                </CardHeader>
                                <InputText @bind-Value="@this.topic" />
                            </Card>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <Card>
                                <CardHeader>
                                    <b>Payload</b>
                                </CardHeader>

                                <InputTextArea class="form-control w-100" title="Payload" @bind-Value="@this.payload" rows="22" />
                            </Card>
                        </div>
                    </div>
                </div>
            </Card>
        </div>
        <div class="row" style="text-align:center">
            <div class="col">
                <button class="btn btn-primary" style="margin:20px; width:150px" @onclick="Apply">Apply</button>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <hr />
            </div>
        </div>

        <div class="row">
            <div class="col">
                <Tabs @ref="tabs" EnableFadeEffect="true" NavStyle="NavStyle.Tabs">
                    <Tab Title="Errors" Id="ErrorsTab">
                        <Content>
                            <InputTextArea class="form-control w-100" title="Errors" @bind-Value="@this.errorText" rows="15" />
                        </Content>
                    </Tab>
                    <Tab Title="Metrics" IsActive="true">
                        <Content>
                            <InputTextArea class="form-control w-100" title="Result" @bind-Value="@this.resultText" rows="15" />
                        </Content>
                    </Tab>
                    <Tab Title="Logs">
                        <Content>
                            <InputTextArea class="form-control w-100" title="Result" @bind-Value="@this.resultLogText" rows="10" />
                        </Content>
                    </Tab>
                </Tabs>
            </div>
        </div>
    </div>
</div>

@code {
    Tabs tabs;

    [Parameter]
    public string? ExampleId { get; set; }

    private string payload = string.Empty;

    private string processorPattern = string.Empty;

    private string resultText = string.Empty;

    private string errorText = string.Empty;

    private string resultLogText = string.Empty;

    private string topic = "message-topic";

    private async Task Apply()
    {
        var httpClient = Factory.CreateClient("ServerAPI");

        var request = new ApplyPatternToPayloadRequest(this.topic, this.payload, this.processorPattern);
        var response = await httpClient.PostAsJsonAsync("api/ManifestExplorer/ApplyPatternToPayload", request);

        var result = await response.Content.ReadFromJsonAsync<ApplyPatternToPayloadResult>();

        if (result != null)
        {
            this.resultText = result.Metrics;
            this.resultLogText = result.Logs;
            this.errorText = result.Errors;

            if (!string.IsNullOrWhiteSpace(this.errorText))
            {
                await this.tabs.ShowTabByIndexAsync(0);
            }
            else if (!string.IsNullOrWhiteSpace(this.resultText))
            {
                await this.tabs.ShowTabByIndexAsync(1);
            }
            else if (!string.IsNullOrWhiteSpace(this.resultLogText))
            {
                await this.tabs.ShowTabByIndexAsync(2);
            }
        }
    }

    protected override Task OnInitializedAsync()
    {
        if (this.ExampleId != null)
        {
            var example = ExampleData.GetExampleById(this.ExampleId);

            this.topic = example.Topic;
            this.payload = example.Payload;
            this.processorPattern = example.Manifest;
        }

        return base.OnInitializedAsync();
    }
}
