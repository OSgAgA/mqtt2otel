@page "/{UnprocessedPath?}"

@using mqtt2otel.ManifestExplorer.Helper
@inject IJSRuntime JS

@rendermode InteractiveServer
@inject mqtt2otel.ManifestExplorer.Meters.UsageMeter usageMeter

<PageTitle>mqtt2otel manifest explorer</PageTitle>

<div class="flex-container" style="align-content:center">
    <Card class="hide-on-mobile" style="margin:auto; width: 400px; margin-bottom: 50px; margin-top: 70px;">
        <img src="images/logo-new.png" alt="mqtt2otel logo" style="width: 400px; margin: auto" />
    </Card>
    <Card style="max-width: 900px; margin: auto; padding-bottom: 20px;">
        <p style="margin:auto; padding: 30px;  font-size: 24px; text-align: center">
            <b>Welcome to the mqtt2otel explorer.</b>
        </p>

        <p style="margin:auto; padding: 30px;  font-size: 24px; text-align: center">
            <b>What would you like to do?</b>
        </p>

        <div class="d-flex flex-wrap" style="margin: auto;">
            <button class="btn btn-success " style="padding: 30px; margin:30px; background-color: #44b8e7" onclick="window.location.href='./Explorer'">
                <b>Start with an empty explorer</b>
            </button>
            <button class="btn btn-success " style="padding: 30px; margin:30px; background-color: #44b8e7" onclick="window.location.href='./Examples'">
                <b>Choose an example to start with</b>
            </button>
        </div>
    </Card>
</div>

@code
{
    /// <summary>
    /// Gets or sets the part of the path that will not be processed by the page. This is for telemetry purposes only!
    /// </summary>
    [Parameter]
    public string? UnprocessedPath { get; set; }

    /// <summary>
    /// Sends metric data about the client to the metric backend on first render.
    /// </summary>
    /// <param name="firstRender">True if this is the first render of the page.</param>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var browserInfo = await JS.InvokeAsync<ClientInfo>("getClientInfo");

            var parser = UAParser.Parser.GetDefault();
            var clientInfo = parser.ParseUserAgent(browserInfo.UserAgent);
            var os = parser.ParseOS(browserInfo.UserAgent);

            var pageTags = new System.Diagnostics.TagList()
            {
                { "Page", "Home"},
                { "OS_Family", os.Family },
                { "OS", os.ToString() },
                { "Client", clientInfo.Family},
                { "Window.Width", (int)(browserInfo.WindowWidth / 100) * 100 },
                { "Window.Height", (int) (browserInfo.WindowHeight / 100) * 100 },
                { "Language", browserInfo.Language }
            };

            this.usageMeter.PageRequestedCounter.Add(1, pageTags);

            if (this.UnprocessedPath != null)
            {
                var tags = new System.Diagnostics.TagList()
                {
                    { "Path", this.UnprocessedPath }
                };

                this.usageMeter.UnsupportedSubPageCalled.Add(1, tags);
            }
        }

        await base.OnAfterRenderAsync(firstRender);
    }

}
