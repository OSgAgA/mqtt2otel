@page "/examples"
@rendermode InteractiveServer

@attribute [StreamRendering]
@using mqtt2otel.ManifestExplorer.DTOs
@using mqtt2otel.ManifestExplorer.Helper
@using mqtt2otel.ManifestExplorer.Services
@inject IJSRuntime JS
@inject RealUserMonitoring rum

<PageTitle>Examples</PageTitle>

<h1>Examples</h1>

<p>
    Please choose from a set of predefined examples to get you started using the manifest explorer.
</p>

<div class="view-switcher" style="padding: 13px;">
    <span class="view-label @(showTable ? "" : "active")">
        <i class="bi bi-grid-3x3-gap"></i>
        Cards
    </span>

    <Switch @bind-Value="showTable" />

    <span class="view-label @(showTable ? "active" : "")">
        <i class="bi bi-table"></i>
        Table
    </span>
</div>

<div class="view-switcher" style="padding:8px; margin-left: 20px;">
    <label>Filter</label><TextInput @bind-Value="this.activeFilter" />
</div>

@foreach (var categoryExampleMapping in this.categoryExampleMappings)
{
    <h3 style="margin-top:30px">@categoryExampleMapping.Key</h3>
    <hr />

    @if (this.showTable)
    {
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Action</th>
                    <th scope="col">Name</th>
                    <th scope="col">Dexription</th>
                    <th scope="col">Tags</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var example in categoryExampleMapping.Value
                    .Where(value => this.activeFilter.IsWhiteSpace() || value.Name.ToLower().Contains(this.activeFilter.ToLower()) || value.Description.ToLower().Contains(this.activeFilter.ToLower())))
                {
                    string encodedExampleId = Uri.EscapeDataString(example.Id);
                    <tr>
                        <td>
                            <a href="@("Explorer/?exampleId=" + @encodedExampleId)" data-enhance-nav="false">
                                <img src="images/play.png" style="width:40px" />
                            </a>
                        </td>

                        <td>
                            <a href="@("Explorer/?exampleId=" + @encodedExampleId)" data-enhance-nav="false">
                                @example.Name
                            </a>
                        </td>
                        <td>@example.Description</td>
                        <td>
                            <div class="ms-auto d-flex flex-wrap justify-content-start">
                                @foreach (var tag in example.Tags)
                                {
                                    <Button Color="ButtonColor.Info"
                                            Style="padding-left: 5px; padding-right: 5px; padding-top: 2px; padding-bottom: 2px; margin-right:5px;">
                                        @tag
                                    </Button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    }
    else
    {
        <div class="d-flex flex-wrap">
            @foreach (var example in categoryExampleMapping.Value
                    .Where(value => this.activeFilter.IsWhiteSpace() || value.Name.ToLower().Contains(this.activeFilter.ToLower()) || value.Description.ToLower().Contains(this.activeFilter.ToLower())))
            {
                string encodedExampleId = Uri.EscapeDataString(example.Id);

                <Card Class="mb-4" Style="width:23rem; margin: 10px">
                    <CardBody Class="d-flex flex-column">
                        <CardTitle class="d-flex align-items-center">
                            <div><b>@example.Name</b></div>

                            <div class="ms-auto d-flex flex-wrap justify-content-end">
                                @foreach (var tag in example.Tags)
                                {
                                    <Button Color="ButtonColor.Info"
                                            Style="padding-left: 5px; padding-right: 5px; padding-top: 2px; padding-bottom: 2px; margin-right:5px;">
                                        @tag
                                    </Button>
                                }
                            </div>
                        </CardTitle>
                        <hr style="margin-left: 0px; margin-right: 0px; margin-top:0px; margin-bottom:10px;" />
                        <CardText>
                            @example.Description
                            <div class="mt-auto text-center" style="margin:0px">
                                <a href="@("Explorer/?exampleId=" + @encodedExampleId)" data-enhance-nav="false">
                                    <img src="images/play.png" style="width:80px" />
                                </a>
                            </div>
                        </CardText>
                    </CardBody>
                </Card>
            }
        </div>
    }
}

@code
{
    /// <summary>
    /// A indicator, that determines whether data should be shown inside a table or in cards.
    /// </summary>
    private bool showTable;

    /// <summary>
    /// The curently active filter.
    /// </summary>
    private string activeFilter = string.Empty;

    /// <summary>
    /// All available examples.
    /// </summary>
    private Dictionary<string, List<ExampleData>> categoryExampleMappings = ExampleData.GetAllByCategories();

    /// <summary>
    /// Sends metric data about the client to the metric backend on first render.
    /// </summary>
    /// <param name="firstRender">True if this is the first render of the page.</param>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var browserInfo = await JS.InvokeAsync<ClientInfo>("getClientInfo");

            rum.RecordPageLoad(browserInfo, "Examples");
        }

        await base.OnAfterRenderAsync(firstRender);
    }
}
