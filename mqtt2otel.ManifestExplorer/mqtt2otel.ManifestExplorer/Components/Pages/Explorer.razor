@page "/Explorer/"

@using Microsoft.AspNetCore.WebUtilities
@using mqtt2otel.ManifestExplorer.Components.Controls
@using mqtt2otel.ManifestExplorer.DTOs
@using mqtt2otel.ManifestExplorer.Helper
@using mqtt2otel.ManifestExplorer.Services
@using mqtt2otel.ManifestExplorer.Settings
@using mqtt2otel.Shared
@inject IJSRuntime JS

@rendermode InteractiveServer
@inject NavigationManager NavManager
@inject IHttpClientFactory Factory
@inject ILogger<Explorer> logger
@inject Microsoft.Extensions.Options.IOptions<FeatureToggles> featureToggles
@inject RealUserMonitoring rum

<PageTitle>mqtt2otel manifest explorer</PageTitle>

<div class="container-fluid">

    <CreateJsonDialog @ref="modal" Data="@this.Data" Result="@this.Result" />

    <div class="row g-4">
        <div class="col-12 col-lg-5">
            <h3 style="text-align: center;">MQTT</h3>
            <div style="padding:10px;">
                <MqttInput Data="this.Data.Setup.MqttData[this.CurrentMessage]" />

                <div class="col" style="text-align: right; margin-top:20px;">
                    <button title="Go to previous message" class="btn btn-primary withShadow" style="background-color: #44b8e7" @onclick="GotoPreviousMessage"><i class="bi bi-play-fill" style="transform: scaleX(-1); display: inline-block;"></i></button>
                    <button Active="false" class="btn btn-outline-primary">@(this.CurrentMessage + 1)/@this.Data.Setup.MqttData.Count</button>
                    <button title="Go to next message" class="btn btn-primary withShadow" style="background-color: #44b8e7" @onclick="GotoNextMessage"><i class="bi bi-play-fill"></i></button>
                    <button title="Add new empty message" class="btn btn-primary withShadow" style="background-color: #44b8e7" @onclick="AddEmptyMessage"><i class="bi bi-plus-lg"></i></button>
                    <button title="Clone current message" class="btn btn-primary withShadow" style="background-color: #44b8e7" @onclick="CloneCurrentMessage"><i class="bi bi-copy"></i></button>
                    <button title="Delete current message" class="btn btn-primary withShadow" style="background-color: #44b8e7" @onclick="DeleteCurrentMessage"><i class="bi bi-trash3"></i></button>
                    <button title="Move current message left" class="btn btn-primary withShadow" style="background-color: #44b8e7" @onclick="MoveCurrentMessageLeft"><i class="bi bi-arrow-bar-left"></i></button>
                    <button title="Move current message right" class="btn btn-primary withShadow" style="background-color: #44b8e7" @onclick="MoveCurrentMessageRight"><i class="bi bi-arrow-bar-right"></i></button>
                </div>
            </div>
            <ExampleLinksViewer Data="this.Data" />
        </div>

        <div class="col-12 col-lg-7">
            <h3 class="add-top-margin-on-mobile" style="text-align: center;">mqtt2otel</h3>

            <ManifestEditor @ref="@this.manifestEditor" InitialText="@this.Data.Setup.Manifest" />

            <div class="row">
                <div class="col" style="text-align: center">
                    <button data-testid="button-apply" class="btn btn-primary withShadow" style="margin:20px; width:150px; background-color: #44b8e7" @onclick="Apply" accesskey="a">Apply (Alt-A)</button>
                    @if (featureToggles.Value.ShowCreateJsonButton)
                    {
                        <button class="btn btn-primary withShadow" style="margin:20px; width:150px; background-color: #44b8e7" @onclick="ShowModal">Create Json</button>
                    }
                </div>
            </div>

            <hr />

            <h3 style="text-align: center;">Open telemetry result</h3>

            @* The results *@

            <div class="row">
                <div class="col">
                    <ResultViewer Data="@this.Result" @bind-ShowDetails="@this.Data.ShowResultDetails" />
                </div>
            </div>

        </div>
    </div>
</div>

@code
{
    /// <summary>
    /// The modal dialog used for creating json data.
    /// </summary>
    CreateJsonDialog modal = new();

    /// <summary>
    /// A reference to the manifest editor.
    /// </summary>
    ManifestEditor manifestEditor = new();

    /// <summary>
    /// Gets or sets the id of the example that should be used to prefill the page. May be null if no example is provided.
    /// </summary>
    public string? ExampleId { get; set; }

    /// <summary>
    /// The result received via the ApplyPatternToPayload request. Maybe null if request is not yet called,
    /// or if not successfull.
    /// </summary>
    private ApplyPatternToPayloadResult? Result = null;

    /// <summary>
    /// A guard to test, whether the page is already initialized.
    /// </summary>
    private bool isInitialized = false;

    /// <summary>
    /// Contains the data used by the explorer for testing different inputs based on incoming messages.
    /// </summary>
    private TestCaseData Data = new TestCaseData();

    /// <summary>
    /// The (zero-based) index of the current message shown.
    /// </summary>
    private int CurrentMessage = 0;

    /// <summary>
    /// Apply the provided data and set the result tabs.
    /// </summary>
    private async Task Apply()
    {
        rum.RecordExampleApplied(this.ExampleId);

        var httpClient = Factory.CreateClient("ServerAPI");

        try
        {
            this.Data.Setup.Manifest = await this.manifestEditor.GetValueAsString();
        }
        catch (Exception ex)
        {
            this.logger.LogError(ex, "Could not read monacco editor text.");
        }

        var request = new ApplyPatternToPayloadData(this.Data.Setup.MqttData[this.CurrentMessage], this.Data.Setup.Manifest);
        var response = await httpClient.PostAsJsonAsync("api/ManifestExplorer/ApplyPatternToPayload", request);
        this.Result = await response.Content.ReadFromJsonAsync<ApplyPatternToPayloadResult>();

        this.StateHasChanged();
    }

    /// <summary>
    /// Called when the side is initialized. Will load example data if an example id is provided.
    /// </summary>
    /// <returns></returns>
    protected override async Task OnInitializedAsync()
    {
        if (!this.isInitialized)
        {
            this.isInitialized = true;

            var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
            if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("exampleId", out var exampleId))
            {
                this.ExampleId = exampleId;
            }

            if (this.ExampleId != null)
            {
                rum.RecordExampleRequested(this.ExampleId);
                this.Data = TestCaseData.GetById(this.ExampleId);
            }
        }

        await base.OnInitializedAsync();
    }

    /// <summary>
    /// Sends metric data about the client to the metric backend on first render.
    /// </summary>
    /// <param name="firstRender">True if this is the first render of the page.</param>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var browserInfo = await JS.InvokeAsync<ClientInfo>("getClientInfo");

            rum.RecordPageLoad(browserInfo, "Explorer");
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    /// <summary>
    /// Shows the modal dialog.
    /// </summary>
    private async Task ShowModal()
    {
        await modal.Show();
    }

    /// <summary>
    /// Goes to the previous mqtt message (stays at number 1, if no previous message exists).
    /// </summary>
    private void GotoPreviousMessage()
    {
        if (this.CurrentMessage > 0) this.CurrentMessage--;

        this.StateHasChanged();
    }

    /// <summary>
    /// Goes to the next mqtt message (if existing).
    /// </summary>
    private void GotoNextMessage()
    {
        if (this.Data.Setup.MqttData.Count > this.CurrentMessage + 1) this.CurrentMessage++;
    }


    /// <summary>
    /// Adds a new empty mqtt message.
    /// </summary>
    private void AddEmptyMessage()
    {
        this.Data.Setup.MqttData.Add(new Metadata.MqttSetupData());

        this.CurrentMessage++;
    }

    /// <summary>
    /// Clones the current message and adds it right after the current message.
    /// </summary>
    private void CloneCurrentMessage()
    {
        this.Data.Setup.MqttData.Add(this.Data.Setup.MqttData[this.CurrentMessage].Clone());

        this.CurrentMessage++;
    }

    /// <summary>
    /// Deletes current message. Creates new empty message if no messages are left.
    /// </summary>
    private void DeleteCurrentMessage()
    {
        this.Data.Setup.MqttData.RemoveAt(this.CurrentMessage);

        if (this.Data.Setup.MqttData.Count == 0) this.AddEmptyMessage();

        if (this.Data.Setup.MqttData.Count - 1 <= this.CurrentMessage && this.CurrentMessage > 0) this.CurrentMessage--;
    }

    /// <summary>
    /// Moves the current message to the left.
    /// </summary>
    private void MoveCurrentMessageLeft()
    {
        if (this.CurrentMessage < 1) return;

        var message = this.Data.Setup.MqttData[this.CurrentMessage];

        this.Data.Setup.MqttData.RemoveAt(this.CurrentMessage);
        this.Data.Setup.MqttData.Insert(--this.CurrentMessage, message);
    }

    /// <summary>
    /// Moves the current message to the right.
    /// </summary>
    private void MoveCurrentMessageRight()
    {
        if (this.CurrentMessage >= this.Data.Setup.MqttData.Count - 1) return;

        var message = this.Data.Setup.MqttData[this.CurrentMessage];

        this.Data.Setup.MqttData.RemoveAt(this.CurrentMessage);
        this.Data.Setup.MqttData.Insert(++this.CurrentMessage, message);
    }
}
